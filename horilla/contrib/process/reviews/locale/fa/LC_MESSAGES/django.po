msgid "Invalid decision."
msgstr "تصمیم نامعتبر است."

#, python-format
msgid ""
"%(field)s was approved in %(process)s by %(approver)s. Comment: %(comment)s"
msgstr ""
"%(field)s توسط %(approver)s در %(process)s تأیید شد. نظر: %(comment)s"

#, python-format
msgid ""
"%(field)s was rejected in %(process)s by %(approver)s. Reason: %(comment)s"
msgstr ""
"%(field)s توسط %(approver)s در %(process)s رد شد. دلیل: %(comment)s"

msgid ""
"All approvers have approved all review fields. Review completed successfully."
msgstr "همه تأییدکنندگان همه فیلدهای بررسی را تأیید کردند. بررسی با موفقیت کامل شد."

msgid ""
"You have approved all fields. Waiting for other approvers to complete their "
"review."
msgstr "شما همه فیلدها را تأیید کرده‌اید. در انتظار اتمام بررسی سایر تأییدکنندگان."
